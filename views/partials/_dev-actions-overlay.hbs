{{#if DEV_LOGIN}}
<div id="dev-actions-overlay" class="dev-actions-overlay">
    <button type="button" class="dev-actions-overlay__toggle" data-dev-overlay-toggle aria-label="Dev actions" aria-expanded="false">Dev Actions</button>
    <div class="dev-actions-overlay__panel" data-dev-overlay-panel hidden>
        <button type="button" data-dev-action="flush-cache" class="dev-actions-overlay__action">Flush cache</button>
    </div>
</div>
{{/if}}
