<div class="bracket-nav">
  <button type="button" class="bracket-nav__toggle" aria-expanded="false" aria-controls="bracket-nav-list">
    {{nav.label}}
  </button>
  <ul class="bracket-nav__list" id="bracket-nav-list">
    {{#each nav.items}}
      <li class="bracket-nav__item">
        <a class="bracket-nav__link{{#if active}} is-active{{/if}}" href="{{href}}">{{label}}</a>
      </li>
    {{/each}}
  </ul>
</div>
